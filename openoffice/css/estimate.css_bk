}
.est03send:hover,.est03back1:hover,.est03back2:hover{
	opacity:0.7;
}
.est03back1{
	background:url('../img_estimate/btn_back1.gif');width:210px;height:45px;border:0px solid;cursor:pointer;
}
.est03back2{
	background:url('../img_estimate/btn_back2.gif');width:210px;height:45px;border:0px solid;cursor:pointer;
}

ul#estBTNBox{
	width:480px;
	margin:0 0 0 100px;
}
ul#estBTNBox li{
	float:left;
	width:210px;
	margin:0 20px 0 0;
}

