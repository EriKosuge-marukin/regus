@charset "utf-8";
/* 各オフィスページ専用スタイル */

#estDyna{
    width:820px;
    /*overflow:visible;*/
    margin:0 auto;
float:none;
clear:both;
text-align:center;
padding:0 0 20px 0; 
font-size:14px;
line-height:1.5;
}
#estDyna h1{clear:both;
background:#d6e8f7;
border-left:#217eb4 5px solid;
padding:4px 10px;
font-size:16px;
line-height:1.3;
color:#000000;
font-weight:normal;
 text-align:left;
}
#estDynaIn{
	 width:660px;
	 margin:16px 0 0 72px;
	 text-align:left;
}
span.status{
	/*color:#217eb4;*/
	color:#ff0000;
	font-weight:normals;
	border:1px #fff solid;
	background:#fff;
	font-size:16px;
}

.roomN{
font-size:14px;
color:#000000;
font-weight:normal;
width:260px;
text-align:center;
display: table-cell;
padding:8px;
}
.roomNtttl{
background-color:#217eb4;
background-image:none;
color:#ffffff !important;
font-size:18px !important;
line-height:1.0;
width:400px;
}
.esTtl{background:#d6e8f7;
}





/*角まる/*/
#hoge {
border-radius: 5px;
-webkit-border-radius: 5px;
-moz-border-radius: 5px;
behavior: url(“css/PIE.htc”);
}

/*estimate01_______________________________*/
.estFull{
	width:660px;
}
.estFull .flL{
	width:368px;
}
.estFull .flR{
	width:290px;
}
.estFull .flR p{
	margin:0 0 30px;
}
/*table*/
table.estTable01{
width: 100%;
border-collapse: collapse;
}
table.estTable01 th{
width: 50%;
padding: 12px 40px;
text-align: left;
vertical-align: top;
color: #333;
background-color: #f8f8f8;
border: 1px solid #b9b9b9;
font-weight:normal;
}
table.estTable01 td{
padding: 12px;
text-align:center;
background-color: #fff;
border: 1px solid #b9b9b9;
}
#estDyna h3{text-align:center;
margin:0 0 10px;
font-weight:bold;}
.est01Form{
	background:#ededed;
	padding:26px 22px;text-align:center;
}
.est01Form dl dt.box1{
	border-radius: 5px 5px 0px 0px / 5px 5px 0px 0px;
	-webkit-border-radius:  0px 0px 5px 5px /  0px 0px 5px 5px;
-moz-border-radius:  0px 0px 5px 5px /  0px 0px 5px 5px;
	background:#dadada;
	padding:10px;
}
.est01Form  dl dd.box2{
	border-radius:  0px 0px 5px 5px /  0px 0px 5px 5px;
	-webkit-border-radius:   0px 0px 5px 5px /  0px 0px 5px 5px;
-moz-border-radius:   0px 0px 5px 5px /  0px 0px 5px 5px;
	background:#ffffff;
	padding:10px 20px 20px 20px;
	text-align:left;
	margin:0;
}
.est01Form .period{
	border-radius: 5px;
	-webkit-border-radius: 5px;
-moz-border-radius: 5px;
	background:#ffffff;
	padding:10px 20px 20px 20px;
	text-align:left;
	margin:0;
}
.est01Form .period p#periodDis{
	background:#217eb4;
	color:#fff;
	padding:3px 30px;
	margin:10px 45px 5px 45px;
	text-align:center;
}
.est01Form select{
	min-width: 30px;
}

p.estNote{
padding-left: 0.7em;
 text-indent: -0.5em;
 font-size:12px;
 line-height:1.2;
}
/*___form estimate button______________________*/
/*input[type=radio], input[type=checkbox] {
  display: none;
}*/
input[type=text]{
	font-size:14px;
	line-height:1.0;
}
input[type="radio"]{
/*  -webkit-appearance: none;*/
  width:15px;
  height:15px;
 /* border:1px solid #19283C;
  border-radius:15px;
  -webkit-border-radius: 15px;
-moz-border-radius: 15px;
  background:transparent;*/
  opacity:0.5;
  
}
input[type="radio"]:checked{
  background:#49ace5;
  opacity:1;
}

input[type="checkbox"]{
  /*-webkit-appearance: none;*/
  width:13px;
  height:13px;
  /*border:1px solid #19283C;
  border-radius:2px;
  -webkit-border-radius: 2px;
-moz-border-radius: 2px;*/
  background:transparent;
  opacity:0.5;
}
input[type="checkbox"]:checked{
  background:#38a6f3;
  opacity:1;
}
ul.eat01form li{
	width:283px;
	float:left;
	margin:5px 0 0 0;
}
ul.eat01form li.lo{
	width:600px;
	margin:5px 0 0 0;
}
ul.eat01form02 li{
	width:190px;
	float:left;
	margin:5px 0 0 0;
}
ul.eat01form03 li{
	width:95px;
	float:left;
	margin:5px 0 0 0;
}
p#periodUse{
	float:left;
	width:75px;
	margin:5px 0 0 0;
}
.periodBox{
	margin:0 45px;
}
p.priodSelect{
	margin:0 45px 15px 45px;
	text-align:right;
	font-size:80%;
}
.est01submit{
	background:url('../img_estimate/btn_estimate.gif');width:210px;height:45px;border:0px solid;cursor:pointer;
}
.est01submit:hover {
	opacity:0.8;
}
a.over:hover{
	opacity:0.8;
}

/*estimate02_______________________________*/

.flLHlf{
	float:left;
	width:320px;
}
.flRHlf{
	float:right;
	width:320px;
}
/*table*/
table.estTable03{
width:100%;
border-collapse: collapse;
}
table.estTable03 td.ttl{
	background:#e4e4e4;
	font-size:16px;
}
table.estTable03 td.sum{
	background:#fff1f1;
}
table.estTable03 th{
width: 65%;
padding: 12px 10px;
text-align: left;
vertical-align: top;
color: #333;
background-color: #f8f8f8;
border: 1px solid #b9b9b9;
font-weight:normal;
}
table.estTable03 th.sum{
	background:#fff1f1 !important;
}
table.estTable03 td{
padding: 12px;
text-align:center;
background-color: #fff;
border: 1px solid #b9b9b9;
}
table.estTable04{
width:100%;
border-collapse: collapse;
}
table.estTable04 td.ttl{
	background:#e4e4e4;
	font-size:16px;
}

table.estTable04 th{
width: 50%;
padding: 12px 0;
text-align: center;
vertical-align: top;
color: #333;
background-color: #f8f8f8;
border: 1px solid #b9b9b9;
font-weight:normal;
}

table.estTable04 td{
padding: 12px;
text-align:center;
background-color: #fff;
border: 1px solid #b9b9b9;
}
.set02bgred{
	background:#fff1f1;
	border-radius: 5px;
	-webkit-border-radius: 5px;
-moz-border-radius: 5px;
	padding:10px;
}
dl#est02Cos{
width:450px;
font-size:16px;
margin-left:200px;
}
dl#est02Cos dt{
	width: 200px;
}
dl#est02Cos dd{
	margin: -1.6em 0 4px 0;
padding: 0 0 4px 180px;
color:#D10202;
font-weight:bold;
}
.est01apply{
	background:url('../img_estimate/btn_apply.gif');width:210px;height:45px;border:0px solid;cursor:pointer;
}
.est01apply:hover{
	opacity:0.7;
}

h2#est{
	background-color:#fff ;
	background-image:none;
	color:#000000;
	padding:40px 0 40px 0;
	margin: 0 0 0-15px;
	font-size:18px;
}


.est01confirm{
	background:url('../img_estimate/btn_confirm.gif');width:210px;height:45px;border:0px solid;cursor:pointer;
}
.est01confirm:hover{
	opacity:0.7;
}

/*CONFIRM___________________________*/
table.estTable05{
width:100%;
border-collapse: collapse;
}
table.estTable05 td.ttl{
	background:#e4e4e4;
	font-size:16px;
}

table.estTable05 th{
width: 45%;
padding: 5px 10px;
text-align: left;
vertical-align: center;
color: #333;
background-color: #f8f8f8;
border: 1px solid #b9b9b9;
font-weight:normal;
}

table.estTable05 td{
padding: 12px;
text-align:center;
background-color: #fff;
border: 1px solid #b9b9b9;
}
.estAppNote{
	font-size:11px;
	line-height:1.2;
	color:#777777;
}






/*___form input______________________*/
input[type=text].nor{
-webkit-appearance: none;
   border-radius: 3px;
   -moz-border-radius: 3px;
   -webkit-border-radius: 3px;
   background:#eaeaea;
   width:300px;
   height:30px;
   padding:0 2px;
   border:solid 1px #eeeeee;
}
input[type=text].nor2{
-webkit-appearance: none;
   border-radius: 3px;
   -moz-border-radius: 3px;
   -webkit-border-radius: 3px;
   background:#eaeaea;
   width:100px;
   height:30px;
   padding:0 2px;
   border:solid 1px #eeeeee;
} 
input[type=text].nor3{
-webkit-appearance: none;
   border-radius: 3px;
   -moz-border-radius: 3px;
   -webkit-border-radius: 3px;
   background:#eaeaea;
   width:190px;
   height:30px;
   padding:0 2px;
   border:solid 1px #eeeeee;
} 
textarea.nor4{
-webkit-appearance: none;
   border-radius: 3px;
   -moz-border-radius: 3px;
   -webkit-border-radius: 3px;
   background:#eaeaea;
   width:300px;
   height:100px;
   padding:0 2px;
   border:solid 1px #eeeeee;
   text-align:left;
} 
input[type=text]:focus,textarea :focu{-webkit-appearance: none;
   border:solid 1px #92c5e2;
   
}
 
input[type=text], select,textarea { 
   outline: none;-webkit-appearance: none;
}
ul#conCheck {
	width:620px;
	margin:40px auto 00px auto;
}
ul#conCheck li{
	text-align:left;
}
div#pdf ul#pdfUL{
	width:200px !important;
	padding:50px 0 0px 240px;
}
div#pdf ul#pdfUL li{
	width:80px;
	background:url(../img_estimate/icon-pdf.gif) 0 2px no-repeat;
	padding-left:20px;
	float:left;
}
dl#inputtable {  
     width:340px;  
    }  
dl#inputtable  dt {  
text-align:left;
     float:left;  
     width:120px;  
     padding:5px 0 5px 0px;  
     clear:both;  
     font-weight:normal;  
    }  
dl#inputtable dd {  
     width:200px;  text-align:left;
     margin-left:120px;  
     padding:5px 0px 5px 5px;  
    }  
