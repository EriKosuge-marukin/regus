<script type="text/javascript">
$(function() {
	var topBtn = $('#page-top');	
	topBtn.hide();
	//スクロールが100に達したらボタン表示
	$(window).scroll(function () {
		if ($(this).scrollTop() > 100) {
			topBtn.fadeIn();
		} else {
			topBtn.fadeOut();
		}
	});
	//スクロールしてトップ
    topBtn.click(function () {
		$('body,html').animate({
			scrollTop: 0
		}, 500);
		return false;
    });
});
</script> 

<script type="text/javascript">
$(function() {
	var tokyoBtn = $('#tokyo');	
	//スクロールしてトップ
    tokyoBtn.click(function () {
		$('body,html').animate({
			scrollTop: $('#tokyo_top').offset().top
		}, 500);
		return false;
    });
});
</script>

